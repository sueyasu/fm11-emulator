# FM-11 EX: both main CPU cards fitted; DIP selects which one boots.

# Boot ROM device search switches (FD23, active-low).
# Enabled devices are tried in hardware priority: HDD, 2HD, then 2D.
# This affects boot eligibility, not whether media are mounted.
[DIPSW]
main_cpu = 6809
2D_FDD = true
2HD_FDD = false
HDD = false
# Stage 2-A additional physical DIP settings: parsed only, not yet applied.
boot_drive = 0          # BootLoader SW1-2: 0..3
bubble = false          # BootLoader SW5 (128 KiB bubble)
serial_cd = ignore      # Communication SW2: ignore | cd_dsr (RX gating)
serial_mode = async     # Communication SW3: async | sync (no physical sync)
serial_baud_sw4_8 = 4    # Communication SW4-8: 00100 (ooxoo), ASYNC 4800 baud
display_lines = 400     # System Select SW1: 200 | 400

# Main RAM fitted to the computer, used by both CPU cards and the
# optional Z80. Valid: 128,256,384,512,640,768,896,1024 KiB.
# Omitted setting preserves the previous full-1-MiB configuration.
[memory]
ram_kib = 1024

# Shared 8251A FD06/FD07: pty (default), none or a physical device.
[serial]
serial0 = pty
# flow_control = none   # default: TX/RX/GND, do not require CTS
# flow_control = rtscts # require physical CTS before transmission
# timing = clocked   # DIP oscillator plus 8251 x1/x16/x64 divider
# timing = immediate # default, preserves OS/PTTY terminal responsiveness
# serial0 = /dev/ttyUSB0
# serial0 = none

[main_6809]
installed = true
cpu = 6309
clock_hz = 2000000
rom = external/roms/boot6809.bin

[main_8088]
installed = true
cpu = v20
clock_hz = 8000000
rom = external/roms/boot8088.bin

# Separate optional CPU. FD05 selects between the DIP-selected
# main CPU and this card, not between the two main CPU cards.
[optional_cpu]
type = none
clock_hz = 4000000

# Select the independent display sub-CPU (6809 or 6309).
# Original display ROM runs in HD6309 compatibility mode with cpu = 6309.
[display_cpu]
cpu = 6809
clock_hz = 2000000
rom = external/roms/display6809.bin
ank_rom = external/roms/ank.bin
# kanji_rom = /path/to/kanji.bin   # JIS level 1, exact 128 KiB
# kanji2_rom = /path/to/kanji2.bin # optional JIS level 2, exact 128 KiB

# Initial SDL window height (not a physical DIP switch).
[display]
height = 400

# 2D Mini-FDC: up to four independent physical drives.
# Raw 320 KiB images and 2D D88 containers are accepted.
[floppy]
# timing = fast  # default: immediate FDC commands
# timing = timed # optional simulated SEEK/RESTORE/STEP timing

[floppy_2d]
# drive0 = /path/to/system.d88
# drive1 = /path/to/data.d88
# drive2 = /path/to/other.d88
# drive3 = /path/to/backup.d88

# 2HD FDC: up to four independent physical drives.
# Native 77x2x26x256 raw images, 2HD D88 (including 128-byte FM IPL),
# and legacy 77x2x8x1024 images are accepted.
[floppy_2hd]
# drive0 = /path/to/disk0.2hd
# drive1 = /path/to/disk1.2hd
# drive2 = /path/to/disk2.2hd
# drive3 = /path/to/disk3.2hd

# MDC HDD controller: one 256-byte-record RAW image.
[hdd]
# fast (default) or timed: independent MDC virtual disk clock
timing = fast
# image = /path/to/m2233b.img
